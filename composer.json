{
  "name": "smknu/sistemabsensi",
  "description": "Sistem Informasi Presensi & Absensi Siswa dan Guru SMK NU WARGABINANGUN",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.1 || ^8.2 || ^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "files": [
      "config/config.php",
      "app/helpers/SecurityHelper.php"
    ],
    "classmap": [
      "app/core/",
      "app/helpers/",
      "app/services/",
      "database/",
      "models/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "test:coverage": "phpunit --colors=always --coverage-text"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
